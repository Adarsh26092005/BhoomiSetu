# ==============================================================================
# NLAMS — National Land Acquisition & Management System
# Backend Environment Configuration (Template)
# ==============================================================================

# Application Environment & Server Settings
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# PostgreSQL with PostGIS Spatial Extension
DATABASE_URL=postgresql://nlams_user:nlams_password@localhost:5432/nlams_db?schema=public

# Authentication & JWT Secrets (Use strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis Caching & Queue Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
